# Environment Configuration for Smart Traffic Congestion System

# PostgreSQL Persistent Database URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traffic_db

# Redis Live Traffic Cache URL
# Format: redis://<host>:<port>/<db_index>
REDIS_URL=redis://localhost:6379/0

# Optional Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
